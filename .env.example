APP_NAME=Loomora
APP_ENV=local
APP_KEY=
# Must be false in production: true shows stack traces in error responses.
APP_DEBUG=true
APP_URL=
# One frontend origin for CORS and auth links. Use HTTPS in hosted environments.
FRONTEND_URL=http://localhost:5173

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_URL=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_DELETION_ENABLED=false
GOOGLE_REDIRECT_URI=

MAIL_MAILER=log
BREVO_API_KEY=
MAIL_FROM_ADDRESS=
FEEDBACK_TO_EMAIL=
