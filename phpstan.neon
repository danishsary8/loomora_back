includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 6
    # Pest tests are not analysed: inside a Pest closure `$this` is the test
    # case, which PHPStan cannot see. The tests themselves run in CI.
    paths:
        - app
        - bootstrap/app.php
        - config
        - database
        - routes
