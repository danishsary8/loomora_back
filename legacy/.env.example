APP_NAME="Daycraft"
APP_ENV=local
# Generate with: php artisan key:generate
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

# Used when the API resolves calendar dates server-side. Set this to the
# deployment's primary timezone; clients should still send their local date.
APP_TIMEZONE=Asia/Phnom_Penh

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# Never commit real credentials — fill these in your local .env only.
# ---------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=your_database_name
DB_USERNAME=your_database_user
DB_PASSWORD=your_database_password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Local default: verification/reset emails are written to storage/logs/laravel.log.
# Production on Render uses Resend's HTTPS API because free Render services block SMTP ports.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
DIAGNOSTIC_TOKEN=
RESEND_API_KEY=

# Optional error monitoring. Leave blank locally to disable all transmission.
SENTRY_LARAVEL_DSN=
SENTRY_ENVIRONMENT=local
SENTRY_RELEASE=
SENTRY_SAMPLE_RATE=1.0
SENTRY_TRACES_SAMPLE_RATE=0.0

# First-party, aggregate analytics. Comma-separate the accounts allowed to
# read /api/v1/internal/analytics. No email is stored in analytics events.
ANALYTICS_ENABLED=true
ANALYTICS_ADMIN_EMAILS=

# Google OAuth (create a Web application in Google Cloud Console).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/v1/auth/google/callback

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Frontend / CORS
# The SPA origin allowed to call this API. Comma-separate multiple origins.
# Never use "*" — the API issues credential-bearing tokens.
# ---------------------------------------------------------------------------
FRONTEND_URL=http://127.0.0.1:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# Sanctum
# Tokens expire after this many minutes (null = never). 43200 = 30 days.
# ---------------------------------------------------------------------------
SANCTUM_TOKEN_EXPIRATION=43200
SANCTUM_STATEFUL_DOMAINS=localhost:5173

# ---------------------------------------------------------------------------
# Aladhan prayer-time upstream (keyless; proxied server-side)
# method 2 = ISNA. Coordinates provide a configurable fallback when a user
# has not granted location access; Phase B will revisit product defaults.
# ---------------------------------------------------------------------------
ALADHAN_BASE_URL=https://api.aladhan.com/v1
ALADHAN_METHOD=2
ALADHAN_TIMEOUT=8
PRAYER_DEFAULT_LATITUDE=11.5564
PRAYER_DEFAULT_LONGITUDE=104.9282
